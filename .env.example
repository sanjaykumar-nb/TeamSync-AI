# Core
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DB_PASSWORD=teamsync_dev_password
DATABASE_URL=postgresql+asyncpg://teamsync:${DB_PASSWORD}@localhost:5432/teamsync

# Redis
REDIS_URL=redis://localhost:6379/0

# GitHub (optional): read-only token. Public repositories work without one, at a lower rate limit.
GITHUB_TOKEN=

# AI Service
GROQ_API_KEY=your-groq-api-key-here
AI_SERVICE_URL=http://localhost:8001
AI_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=app-password
EMAIL_FROM=noreply@teamsync.ai

# Who may call the API from a browser: a plain list, or JSON. Not a secret.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Sign-in and sign-up attempts allowed per caller per window. 0 turns the limit off.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Deployment (docker-compose.prod.yml — see docs/DEPLOY.md)
DOMAIN=teamsync.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Environment
ENVIRONMENT=development
# Opens /docs and /redoc. Leave false anywhere the internet can reach.
DEBUG=false
# Only true behind a reverse proxy (the production overlay sets it).
TRUST_PROXY_HEADERS=false