# TLS for both hostnames, certificates fetched and renewed by Caddy itself.
# DOMAIN serves the web app; API_DOMAIN serves the API and the GitHub webhook.
# The AI service is deliberately absent: it has no accounts of its own and is
# reachable only from the backend, inside the compose network.

{
	# Where Let's Encrypt sends expiry warnings. Set ACME_EMAIL in .env.
	email {$ACME_EMAIL:admin@localhost}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
