{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LookUpTheAccountAndTheUbuntuImage",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ssm:GetParameter",
        "ec2:DescribeImages"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadWhatAlreadyExists",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAddresses",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateTheOneInstanceAndWhatItNeeds",
      "Effect": "Allow",
      "Action": [
        "ec2:AllocateAddress",
        "ec2:AssociateAddress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:CreateKeyPair",
        "ec2:CreateSecurityGroup",
        "ec2:CreateTags",
        "ec2:RunInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TakeItDownAgain",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteKeyPair",
        "ec2:DeleteSecurityGroup",
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress",
        "ec2:TerminateInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NothingLargerThanASmallInstance",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotEquals": {
          "ec2:InstanceType": [
            "t2.micro",
            "t3.micro",
            "t3.small",
            "t4g.micro",
            "t4g.small"
          ]
        }
      }
    }
  ]
}
